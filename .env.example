# ==============================================================================
# Bengal Heritage Atlas — Environment Configuration
# ==============================================================================

# Option A: Standard TiDB Cloud / MySQL Configuration
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username_root
DB_PASSWORD=your_tidb_password
DB_NAME=bengal_heritage_atlas
DB_SSL=true

# Option B: Or use a single Connection String (TiDB Cloud / Render DATABASE_URL)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/bengal_heritage_atlas?ssl={"rejectUnauthorized":true}

# Option C: Local Development (MySQL 8)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bengal_heritage_atlas
# DB_SSL=false

# Application Settings
ADMIN_SESSION_SECRET=generate_a_random_secure_secret_for_sessions
PORT=3000
NODE_ENV=production
